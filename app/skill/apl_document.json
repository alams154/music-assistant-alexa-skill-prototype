{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "import": [
    {
      "name": "alexa-layouts",
      "version": "1.7.0"
    }
  ],
  "resources": [
    {
      "description": "Default resource definitions for Audio template",
      "colors": {
        "colorText": "@colorText"
      },
      "dimensions": {
        "assetHeight": "425dp",
        "assetWidth": "425dp",
        "coverImageShadowRadius": "40dp",
        "coverImageShadowVerticalOffset": "20dp",
        "mainViewHeight": "85%",
        "mainViewTopSpacing": "15%",
        "primaryControlSize": "120dp",
        "secondaryControlSize": "92dp",
        "sliderIndeterminateHeight": "80dp",
        "sliderPaddingTop": "@spacingMedium",
        "trackInfoLeftPadding": "@spacingMedium",
        "transportLayoutMargins": "0"
      },
      "numbers": {
        "primarySongTextMaxLines": 3,
        "secondarySongTextMaxLines": 2
      }
    },
    {
      "description": "Resource definitions for Audio template - hubLandscapeMedium",
      "when": "${@viewportProfile == @hubLandscapeMedium}",
      "dimensions": {
        "assetHeight": "300dp",
        "assetWidth": "300dp",
        "primaryControlSize": "80dp",
        "secondaryControlSize": "60dp",
        "sliderPaddingTop": "0"
      }
    },
    {
      "description": "Resource definitions for Audio template - hubLandscapeSmall",
      "when": "${@viewportProfile == @hubLandscapeSmall}",
      "dimensions": {
        "assetHeight": "206dp",
        "assetWidth": "206dp",
        "primaryControlSize": "80dp",
        "secondaryControlSize": "60dp",
        "sliderIndeterminateHeight": "60dp",
        "sliderPaddingTop": "0"
      },
      "numbers": {
        "primarySongTextMaxLines": 1,
        "secondarySongTextMaxLines": 2
      }
    },
    {
      "description": "Resource definitions for Audio template - round",
      "when": "${@viewportProfile == @hubRoundSmall}",
      "dimensions": {
        "assetHeight": "96dp",
        "assetWidth": "96dp",
        "mainViewHeight": "80%",
        "mainViewTopSpacing": "20%",
        "primaryControlSize": "80dp",
        "secondaryControlSize": "60dp",
        "sliderIndeterminateHeight": "40dp",
        "sliderPaddingTop": "@spacingSmall",
        "trackInfoLeftPadding": 0
      },
      "numbers": {
        "primarySongTextMaxLines": 1,
        "secondarySongTextMaxLines": 1
      }
    },
    {
      "description": "Resource definitions for Audio template - tv full screen",
      "when": "${@viewportProfile == @tvLandscapeXLarge}",
      "dimensions": {
        "assetHeight": "240dp",
        "assetWidth": "240dp",
        "coverImageShadowRadius": "20dp",
        "coverImageShadowVerticalOffset": "10dp",
        "primaryControlSize": "60dp",
        "secondaryControlSize": "46dp",
        "sliderIndeterminateHeight": "40dp"
      },
      "numbers": {
        "primarySongTextMaxLines": 4,
        "secondarySongTextMaxLines": 2
      }
    },
    {
      "when": "${viewport.theme == 'light'}",
      "colors": {
        "colorText": "@colorTextReversed"
      }
    }
  ],
  "layouts": {
    "AudioPlayer": {
      "parameters": [
        {
          "name": "audioControlType",
          "description": "The type of audio control to use. Default is skip (foward and backwards). Other options are skip | jump10 | jump30 | none.",
          "type": "string",
          "default": "skip"
        },
        {
          "name": "audioSources",
          "description": "Audio single source or an array of sources. Audios will be in a playlist if multiple sources are provided.",
          "type": "any"
        },
        {
          "name": "backgroundImageSource",
          "description": "URL for the background image source.",
          "type": "string"
        },
        {
          "name": "coverImageSource",
          "description": "URL for the cover image source. If not provided, text content will be left aligned.",
          "type": "string"
        },
        {
          "name": "headerTitle",
          "description": "Title text to render in the header.",
          "type": "string"
        },
        {
          "name": "headerSubtitle",
          "description": "Subtitle Text to render in the header.",
          "type": "string"
        },
        {
          "name": "headerAttributionImage",
          "description": "URL for attribution image or logo source (PNG/vector).",
          "type": "string"
        },
        {
          "name": "primaryText",
          "description": "Primary text for the media.",
          "type": "string"
        },
        {
          "name": "secondaryText",
          "description": "Secondary text for the media.",
          "type": "string"
        },
        {
          "name": "sliderType",
          "description": "Determinate for full control of the slider with transport control. Indeterminate is an ambient progress bar with animation.",
          "type": "string",
          "default": "determinate"
        },
        {
          "name": "audioNextSource",
          "type": "string",
          "description": "Dummy second source: moving to it means 'next'."
        }
      ],
      "item": [
        {
          "type": "Container",
          "height": "100vh",
          "width": "100vw",
          "bind": [
            {
              "name": "sliderThumbPosition",
              "type": "number",
              "value": 0
            },
            {
              "name": "sliderActive",
              "type": "boolean",
              "value": false
            },
            {
              "name": "videoProgressValue",
              "type": "number",
              "value": 0
            },
            {
              "name": "videoTotalValue",
              "type": "number",
              "value": 0
            },
            {
              "name": "refreshTick",
              "type": "number",
              "value": 0
            },
            {
              "name": "trackOffset",
              "type": "number",
              "value": 0
            },
            {
              "name": "trackTotal",
              "type": "number",
              "value": 0
            },
            {
              "name": "pendingElapsed",
              "type": "number",
              "value": 0
            },
            {
              "name": "needsResync",
              "type": "boolean",
              "value": false
            },
            {
              "name": "videoPlaying",
              "type": "boolean",
              "value": true
            },
            {
              "name": "lyricsLines",
              "type": "any",
              "value": []
            },
            {
              "name": "lyricsVisible",
              "type": "boolean",
              "value": false
            },
            {
              "name": "lyricsAvailable",
              "type": "boolean",
              "value": false
            },
            {
              "name": "lyricsSynced",
              "type": "boolean",
              "value": false
            },
            {
              "name": "lyricsIndex",
              "type": "number",
              "value": 0
            },
            {
              "name": "trackPos",
              "type": "number",
              "value": 0
            },
            {
              "name": "lyricsBuckets",
              "type": "any",
              "value": []
            },
            {
              "name": "lyricsTitle",
              "type": "string",
              "value": "${primaryText}"
            },
            {
              "name": "lyricsArtist",
              "type": "string",
              "value": ""
            }
          ],
          "onMount": [
            {
              "type": "Sequential",
              "repeatCount": 100000,
              "commands": [
                {
                  "type": "Idle",
                  "delay": 1000
                },
                {
                  "type": "SetValue",
                  "property": "refreshTick",
                  "value": "${refreshTick + 1}"
                },
                {
                  "type": "SendEvent",
                  "arguments": [
                    "MetadataRefresh",
                    "${refreshTick}",
                    "${videoProgressValue}",
                    "${videoPlaying}"
                  ],
                  "components": [
                    "maReport",
                    "maSeek"
                  ]
                }
              ],
              "sequencer": "maRefresh"
            }
          ],
          "items": [
            {
              "type": "Container",
              "id": "AlexaBackground",
              "description": "Blurred cover background",
              "position": "absolute",
              "width": "100vw",
              "height": "100vh",
              "bind": [
                {
                  "name": "backgroundImageSource",
                  "type": "string",
                  "value": "${backgroundImageSource}"
                }
              ],
              "items": [
                {
                  "type": "Image",
                  "source": "${backgroundImageSource}",
                  "width": "100%",
                  "height": "100%",
                  "scale": "best-fill",
                  "filters": [
                    {
                      "type": "Blur",
                      "radius": 8
                    }
                  ],
                  "overlayColor": "rgba(0, 0, 0, 0.35)"
                }
              ]
            },
            {
              "type": "AlexaHeader",
              "id": "AlexaHeader",
              "width": "100%",
              "headerTitle": "${headerTitle}",
              "headerSubtitle": "${headerSubtitle}",
              "headerAttributionImage": "${headerAttributionImage}"
            },
            {
              "type": "Container",
              "id": "maTopBar",
              "position": "absolute",
              "top": "24dp",
              "left": "@marginHorizontal",
              "right": "@marginHorizontal",
              "direction": "row",
              "alignItems": "start",
              "items": [
                {
                  "type": "Container",
                  "width": "1dp",
                  "grow": 1,
                  "shrink": 1,
                  "paddingRight": "16dp",
                  "display": "${lyricsVisible ? 'normal' : 'invisible'}",
                  "items": [
                    {
                      "type": "Text",
                      "id": "maLyricsTitle",
                      "text": "${lyricsTitle}",
                      "width": "100%",
                      "maxLines": 1,
                      "fontSize": "20dp",
                      "fontWeight": "bold",
                      "textAlign": "left",
                      "color": "#FFFFFF"
                    },
                    {
                      "type": "Text",
                      "id": "maLyricsArtist",
                      "text": "${lyricsArtist}",
                      "width": "100%",
                      "maxLines": 1,
                      "fontSize": "16dp",
                      "textAlign": "left",
                      "color": "#FFFFFFB3",
                      "display": "${lyricsArtist ? 'normal' : 'none'}"
                    }
                  ]
                },
                {
                  "type": "VectorGraphic",
                  "id": "maLogo",
                  "source": "maLogo",
                  "width": "44dp",
                  "height": "44dp",
                  "scale": "best-fit",
                  "opacity": 0.85
                }
              ]
            },
            {
              "type": "Container",
              "position": "absolute",
              "width": "100%",
              "height": "@mainViewHeight",
              "top": "@mainViewTopSpacing",
              "alignItems": "center",
              "justifyContent": "center",
              "items": [
                {
                  "description": "Cover image and track info",
                  "type": "Container",
                  "width": "100%",
                  "paddingLeft": "@marginHorizontal",
                  "paddingRight": "@marginHorizontal",
                  "height": "auto",
                  "direction": "${@viewportProfile != @hubRoundSmall ? 'row' : 'column'}",
                  "items": [
                    {
                      "description": "Cover image",
                      "type": "Container",
                      "id": "Audio_CoverImage",
                      "paddingEnd": "@trackInfoLeftPadding",
                      "justifyContent": "${@viewportProfile != @hubRoundSmall ? 'center' : 'end'}",
                      "items": [
                        {
                          "type": "Container",
                          "height": "@assetHeight",
                          "width": "@assetWidth",
                          "items": [
                            {
                              "type": "AlexaImage",
                              "id": "Audio_CoverArt",
                              "imageSource": "${coverImageSource}",
                              "imageScale": "best-fill",
                              "imageWidth": "@assetWidth",
                              "imageHeight": "@assetHeight",
                              "imageAspectRatio": "square",
                              "imageShadow": true
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "description": "Track Info",
                      "type": "Container",
                      "height": "${@viewportProfile != @hubRoundSmall ? '@assetHeight' : 'auto'}",
                      "direction": "column",
                      "shrink": 1,
                      "alignItems": "${@viewportProfile != @hubRoundSmall ? 'start' : 'bottom'}",
                      "justifyContent": "end",
                      "items": [
                        {
                          "type": "Text",
                          "id": "Audio_PrimaryText",
                          "accessibilityLabel": "${primaryText}",
                          "text": "${primaryText}",
                          "style": "textStyleDisplay4",
                          "textAlign": "${@viewportProfile != @hubRoundSmall ? 'auto' : 'center'}",
                          "paddingBottom": "@spacingXSmall"
                        },
                        {
                          "type": "Text",
                          "id": "Audio_SecondaryText",
                          "accessibilityLabel": "${secondaryText}",
                          "text": "${secondaryText}",
                          "style": "textStyleBody",
                          "textAlign": "${@viewportProfile != @hubRoundSmall ? 'auto' : 'center'}"
                        }
                      ]
                    }
                  ],
                  "display": "${lyricsVisible ? 'none' : 'normal'}"
                },
                {
                  "type": "Container",
                  "id": "maLyricsPanel",
                  "description": "Lyrics",
                  "width": "100%",
                  "height": "46vh",
                  "paddingLeft": "@marginHorizontal",
                  "paddingRight": "@marginHorizontal",
                  "display": "${lyricsVisible ? 'normal' : 'none'}",
                  "items": [
                    {
                      "type": "Sequence",
                      "id": "maLyrics",
                      "width": "100%",
                      "height": "1dp",
                      "scrollDirection": "vertical",
                      "data": "${Array.range(200)}",
                      "item": {
                        "type": "Text",
                        "width": "100%",
                        "paddingTop": "6dp",
                        "paddingBottom": "6dp",
                        "display": "${data < lyricsLines.length ? 'normal' : 'none'}",
                        "text": "${data < lyricsLines.length ? lyricsLines[data].t : ''}",
                        "textAlign": "center",
                        "fontSize": "${lyricsSynced ? '30dp' : '24dp'}",
                        "fontWeight": "${lyricsSynced ? 'bold' : 'normal'}",
                        "color": "${data < lyricsLines.length && lyricsLines[data].s >= 0 && trackPos >= lyricsLines[data].s && trackPos < lyricsLines[data].e ? '#FFFFFF' : (lyricsSynced ? '#FFFFFF66' : '#FFFFFFDD')}"
                      },
                      "grow": 1
                    }
                  ],
                  "direction": "column"
                },
                {
                  "type": "Container",
                  "description": "Slider and controls.",
                  "id": "Audio_AudioInfo",
                  "width": "100%",
                  "paddingLeft": "${@marginHorizontal - @spacingMedium}",
                  "paddingRight": "${@marginHorizontal - @spacingMedium}",
                  "items": [
                    {
                      "description": "A hidden Video component to play the audio.",
                      "type": "Video",
                      "id": "videoPlayer",
                      "height": 1,
                      "width": 1,
                      "scale": "best-fill",
                      "autoplay": true,
                      "audioTrack": "background",
                      "source": [
                        "${audioSources}",
                        "${audioNextSource}"
                      ],
                      "position": "absolute",
                      "onPlay": [
                        {
                          "type": "SetValue",
                          "property": "videoTotalValue",
                          "value": "${event.duration}"
                        },
                        {
                          "type": "SetValue",
                          "property": "videoPlaying",
                          "value": true
                        },
                        {
                          "type": "SetValue",
                          "componentId": "maReport",
                          "property": "text",
                          "value": "${event.currentTime}|${event.paused ? 'false' : 'true'}|${trackOffset}|${utcTime}|${lyricsVisible ? 1 : 0}"
                        }
                      ],
                      "onTrackUpdate": [
                        {
                          "type": "SetValue",
                          "property": "videoTotalValue",
                          "value": "${event.duration}"
                        },
                        {
                          "type": "Sequential",
                          "sequencer": "maVoice",
                          "when": "${event.trackIndex == 1}",
                          "commands": [
                            {
                              "type": "SendEvent",
                              "arguments": [
                                "VoiceNext"
                              ]
                            }
                          ]
                        }
                      ],
                      "onTimeUpdate": [
                        {
                          "type": "SetValue",
                          "property": "videoProgressValue",
                          "value": "${event.currentTime}"
                        },
                        {
                          "type": "Sequential",
                          "when": "${needsResync}",
                          "commands": [
                            {
                              "type": "SetValue",
                              "property": "trackOffset",
                              "value": "${event.currentTime - pendingElapsed}"
                            },
                            {
                              "type": "SetValue",
                              "property": "needsResync",
                              "value": false
                            }
                          ]
                        },
                        {
                          "type": "SetValue",
                          "componentId": "AudioPlayerRoot",
                          "property": "trackPos",
                          "value": "${event.currentTime - trackOffset}"
                        },
                        {
                          "type": "SetValue",
                          "componentId": "slider",
                          "property": "progressValue",
                          "value": "${videoProgressValue > trackOffset ? videoProgressValue - trackOffset : 0}"
                        },
                        {
                          "type": "SetValue",
                          "property": "videoTotalValue",
                          "value": "${event.duration}"
                        },
                        {
                          "type": "SetValue",
                          "componentId": "maReport",
                          "property": "text",
                          "value": "${event.currentTime}|${event.paused ? 'false' : 'true'}|${trackOffset}|${utcTime}|${lyricsVisible ? 1 : 0}"
                        },
                        {
                          "type": "Sequential",
                          "sequencer": "maScroll",
                          "when": "${lyricsSynced && (event.currentTime >= trackOffset && Math.floor((event.currentTime - trackOffset) / 250) < lyricsBuckets.length ? lyricsBuckets[Math.floor((event.currentTime - trackOffset) / 250)] : -1) >= 0 && (event.currentTime >= trackOffset && Math.floor((event.currentTime - trackOffset) / 250) < lyricsBuckets.length ? lyricsBuckets[Math.floor((event.currentTime - trackOffset) / 250)] : -1) != lyricsIndex}",
                          "commands": [
                            {
                              "type": "SetValue",
                              "componentId": "AudioPlayerRoot",
                              "property": "lyricsIndex",
                              "value": "${(event.currentTime >= trackOffset && Math.floor((event.currentTime - trackOffset) / 250) < lyricsBuckets.length ? lyricsBuckets[Math.floor((event.currentTime - trackOffset) / 250)] : -1)}"
                            },
                            {
                              "type": "ScrollToIndex",
                              "componentId": "maLyrics",
                              "index": "${(event.currentTime >= trackOffset && Math.floor((event.currentTime - trackOffset) / 250) < lyricsBuckets.length ? lyricsBuckets[Math.floor((event.currentTime - trackOffset) / 250)] : -1)}",
                              "align": "center",
                              "when": "${lyricsVisible}"
                            }
                          ]
                        }
                      ],
                      "onTrackReady": [
                        {
                          "type": "SetValue",
                          "property": "videoTotalValue",
                          "value": "${event.duration}"
                        }
                      ],
                      "onTrackFail": [
                        {
                          "type": "SetValue",
                          "property": "videoTotalValue",
                          "value": "0"
                        },
                        {
                          "type": "SetValue",
                          "property": "videoPlaying",
                          "value": false
                        }
                      ],
                      "onPause": [
                        {
                          "type": "SetValue",
                          "property": "videoPlaying",
                          "value": false
                        },
                        {
                          "type": "SetValue",
                          "componentId": "maReport",
                          "property": "text",
                          "value": "${event.currentTime}|${event.paused ? 'false' : 'true'}|${trackOffset}|${utcTime}|${lyricsVisible ? 1 : 0}"
                        }
                      ],
                      "onEnd": [
                        {
                          "type": "SetValue",
                          "property": "videoPlaying",
                          "value": false
                        },
                        {
                          "type": "SetValue",
                          "componentId": "maReport",
                          "property": "text",
                          "value": "${event.currentTime}|end|${trackOffset}|${utcTime}|${lyricsVisible ? 1 : 0}"
                        }
                      ],
                      "bind": [
                        {
                          "name": "trackOffset",
                          "type": "number",
                          "value": 0
                        },
                        {
                          "name": "pendingElapsed",
                          "type": "number",
                          "value": 0
                        },
                        {
                          "name": "needsResync",
                          "type": "boolean",
                          "value": false
                        }
                      ]
                    },
                    {
                      "description": "Determinate Slider Container",
                      "when": "${sliderType != 'indeterminate'}",
                      "type": "Container",
                      "width": "100%",
                      "paddingTop": "@sliderPaddingTop",
                      "items": [
                        {
                          "type": "Container",
                          "width": "100%",
                          "alignItems": "center",
                          "item": [
                            {
                              "type": "AlexaSlider",
                              "id": "slider",
                              "progressValue": "${videoProgressValue > trackOffset ? videoProgressValue - trackOffset : 0}",
                              "totalValue": "${trackTotal}",
                              "positionPropertyName": "sliderThumbPosition",
                              "metadataDisplayed": true,
                              "metadataPosition": "above_right",
                              "width": "100%",
                              "theme": "${viewport.theme}",
                              "onUpCommand": [
                                {
                                  "type": "SetValue",
                                  "property": "sliderActive",
                                  "value": false
                                },
                                {
                                  "type": "SetValue",
                                  "componentId": "maSeek",
                                  "property": "text",
                                  "value": "${sliderThumbPosition}@${elapsedTime}"
                                }
                              ],
                              "onMoveCommand": [
                                {
                                  "type": "SetValue",
                                  "property": "sliderActive",
                                  "value": true
                                }
                              ],
                              "onDownCommand": [
                                {
                                  "type": "SetValue",
                                  "property": "sliderActive",
                                  "value": true
                                }
                              ]
                            },
                            {
                              "type": "Container",
                              "id": "MaSkipButtons",
                              "direction": "row",
                              "alignItems": "center",
                              "justifyContent": "center",
                              "items": [
                                {
                                  "type": "TouchWrapper",
                                  "width": "@secondaryControlSize",
                                  "height": "@secondaryControlSize",
                                  "onPress": [
                                    {
                                      "type": "Sequential",
                                      "commands": [
                                        {
                                          "type": "SetValue",
                                          "property": "opacity",
                                          "value": 0.35
                                        },
                                        {
                                          "type": "SendEvent",
                                          "arguments": [
                                            "Previous"
                                          ]
                                        },
                                        {
                                          "type": "Idle",
                                          "delay": 250
                                        }
                                      ],
                                      "finally": [
                                        {
                                          "type": "SetValue",
                                          "property": "opacity",
                                          "value": 1
                                        }
                                      ]
                                    }
                                  ],
                                  "item": {
                                    "type": "VectorGraphic",
                                    "source": "maSkipPrevious",
                                    "width": "100%",
                                    "height": "100%",
                                    "scale": "best-fit"
                                  }
                                },
                                {
                                  "type": "AlexaTransportControls",
                                  "mediaComponentId": "videoPlayer",
                                  "playPauseToggleButtonId": "playPauseToggleButtonId",
                                  "primaryControlSize": "@primaryControlSize",
                                  "secondaryControls": "none",
                                  "secondaryControlSize": "@secondaryControlSize",
                                  "autoplay": true,
                                  "theme": "${viewport.theme}"
                                },
                                {
                                  "type": "TouchWrapper",
                                  "width": "@secondaryControlSize",
                                  "height": "@secondaryControlSize",
                                  "onPress": [
                                    {
                                      "type": "Sequential",
                                      "commands": [
                                        {
                                          "type": "SetValue",
                                          "property": "opacity",
                                          "value": 0.35
                                        },
                                        {
                                          "type": "SendEvent",
                                          "arguments": [
                                            "Next"
                                          ]
                                        },
                                        {
                                          "type": "Idle",
                                          "delay": 250
                                        }
                                      ],
                                      "finally": [
                                        {
                                          "type": "SetValue",
                                          "property": "opacity",
                                          "value": 1
                                        }
                                      ]
                                    }
                                  ],
                                  "item": {
                                    "type": "VectorGraphic",
                                    "source": "maSkipNext",
                                    "width": "100%",
                                    "height": "100%",
                                    "scale": "best-fit"
                                  }
                                },
                                {
                                  "type": "TouchWrapper",
                                  "id": "maLyricsButton",
                                  "width": "@secondaryControlSize",
                                  "height": "@secondaryControlSize",
                                  "spacing": "@spacingMedium",
                                  "display": "${lyricsAvailable ? 'normal' : 'invisible'}",
                                  "onPress": [
                                    {
                                      "type": "SetValue",
                                      "componentId": "AudioPlayerRoot",
                                      "property": "lyricsVisible",
                                      "value": "${!lyricsVisible}"
                                    },
                                    {
                                      "type": "ScrollToIndex",
                                      "componentId": "maLyrics",
                                      "index": "${lyricsIndex}",
                                      "align": "center",
                                      "when": "${lyricsVisible}"
                                    }
                                  ],
                                  "item": {
                                    "type": "VectorGraphic",
                                    "source": "maLyrics",
                                    "width": "100%",
                                    "height": "100%",
                                    "scale": "best-fit",
                                    "opacity": "${lyricsVisible ? 1 : 0.6}"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "description": "Indeterminate Slider Container",
                      "when": "${sliderType == 'indeterminate'}",
                      "type": "Container",
                      "width": "100%",
