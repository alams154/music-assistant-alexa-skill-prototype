{
  "name": "Music Assistant Alexa Skill",
  "version": "0.0.44-beta",
  "slug": "music_assistant_skill",
  "description": "Skill service for the Music Assistant Alexa player provider. Amazon account login stays in Music Assistant.",
  "url": "https://www.music-assistant.io/player-support/alexa/",
  "stage": "experimental",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "apparmor": false,
  "timeout": 30,
  "homeassistant_api": true,
  "ports": {
    "5000/tcp": 5000
  },
  "ports_description": {
    "5000/tcp": "Skill API. Use http://<Home Assistant host>:5000 as the Music Assistant API URL."
  },
  "map": [
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/homeassistant"
    }
  ],
  "options": {
    "SKILL_HOSTNAME": "",
    "USE_NABU_CASA": false,
    "MA_HOSTNAME": "",
    "APP_USERNAME": "",
    "APP_PASSWORD": "",
    "LOCALE": "en-US",
    "AWS_DEFAULT_REGION": "us-east-1",
    "TZ": "UTC",
    "ENABLE_APL": false,
    "SKIP_URL_VALIDATION": false,
    "MA_API_URL": "",
    "MA_API_TOKEN": ""
  },
  "schema": {
    "SKILL_HOSTNAME": "str?",
    "USE_NABU_CASA": "bool",
    "MA_HOSTNAME": "str?",
    "APP_USERNAME": "str?",
    "APP_PASSWORD": "password?",
    "LOCALE": "str",
    "AWS_DEFAULT_REGION": "str",
    "TZ": "str",
    "ENABLE_APL": "bool",
    "SKIP_URL_VALIDATION": "bool",
    "MA_API_URL": "str?",
    "MA_API_TOKEN": "password?"
  },
  "webui": "http://[HOST]:[PORT:5000]/status",
  "ingress": true,
  "ingress_port": 5000,
  "ingress_entry": "/status",
  "panel_icon": "mdi:speaker",
  "panel_title": "Alexa Skill",
  "host_network": false
}
